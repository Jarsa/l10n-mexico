<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="city_zip_tree_inherit_l10n_mx_toponym" model="ir.ui.view">
        <field name="name">res.city.zip.tree.toponym</field>
        <field name="model">res.city.zip</field>
        <field name="inherit_id" ref="base_location.city_zip_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="l10n_mx_edi_colony" />
            </xpath>
            <xpath expr="//field[@name='city_id']" position="after">
                <field name="state_id" />
            </xpath>
        </field>
    </record>
</odoo>
