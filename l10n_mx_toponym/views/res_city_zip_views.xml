<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="city_zip_tree" model="ir.ui.view">
        <field name="model">res.city.zip</field>
        <field name="inherit_id" ref="base_location.city_zip_tree" />
        <field name="arch" type="xml">
            <list position="inside">
                <header>
                    <button
                        name="action_sepomex_refresh"
                        type="object"
                        string="Update from Correos de México"
                        display="always"
                        groups="base.group_system"
                    />
                </header>
            </list>
            <field name="name" position="after">
                <field name="l10n_mx_edi_colony" />
                <field name="l10n_mx_edi_colony_code" optional="hide" />
                <field name="l10n_mx_edi_locality_id" optional="hide" />
            </field>
        </field>
    </record>
    <record id="city_zip_form" model="ir.ui.view">
        <field name="model">res.city.zip</field>
        <field name="inherit_id" ref="base_location.city_zip_form" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="l10n_mx_edi_colony" />
                <field name="l10n_mx_edi_colony_code" />
                <field name="l10n_mx_edi_locality_id" />
            </field>
        </field>
    </record>
    <record id="view_city_zip_filter" model="ir.ui.view">
        <field name="model">res.city.zip</field>
        <field name="inherit_id" ref="base_location.view_city_zip_filter" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="l10n_mx_edi_colony" />
                <field name="l10n_mx_edi_locality_id" />
            </field>
        </field>
    </record>
</odoo>
