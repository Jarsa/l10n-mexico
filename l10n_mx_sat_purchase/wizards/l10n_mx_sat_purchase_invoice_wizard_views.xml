<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_mx_sat_purchase_invoice_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n_mx_sat.purchase.invoice.wizard.form</field>
        <field name="model">l10n_mx_sat.purchase.invoice.wizard</field>
        <field name="arch" type="xml">
            <form>
                <div
                    class="alert alert-warning"
                    role="alert"
                    invisible="not total_mismatch"
                >
                    The total of the CFDI is different from the total of the purchase orders.
                    Review the bill before posting it.
                </div>
                <group>
                    <field
                        name="purchase_order_ids"
                        widget="many2many_tags"
                        readonly="1"
                    />
                    <field name="partner_id" />
                    <field name="currency_id" invisible="1" />
                    <field name="company_id" invisible="1" />
                    <field name="amount_total" />
                    <field name="l10n_mx_sat_available_document_ids" invisible="1" />
                    <field
                        name="l10n_mx_sat_document_id"
                        options="{'no_create': True}"
                    />
                    <field name="total_mismatch" invisible="1" />
                </group>
                <footer>
                    <button
                        name="action_create_invoice"
                        string="Create Bill"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                        data-hotkey="x"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
