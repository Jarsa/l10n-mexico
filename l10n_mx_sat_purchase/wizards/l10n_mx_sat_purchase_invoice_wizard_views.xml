<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_mx_sat_purchase_invoice_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n_mx_sat.purchase.invoice.wizard.form</field>
        <field name="model">l10n_mx_sat.purchase.invoice.wizard</field>
        <field name="arch" type="xml">
            <form>
                <div
                    class="alert alert-warning"
                    role="alert"
                    invisible="not total_mismatch"
                >
                    The amount to bill differs from the CFDI subtotal. Review the quantities to bill before creating the bill.
                </div>
                <div class="alert alert-info" role="alert" invisible="line_ids">
                    There is no CFDI of this vendor pending to bill in the SAT downloads.
                </div>
                <group>
                    <group>
                        <field
                            name="purchase_order_ids"
                            widget="many2many_tags"
                            domain="[('state', '=', 'purchase'), ('invoice_status', '=', 'to invoice'), ('company_id', '=', company_id), ('currency_id', '=', currency_id), ('partner_id', 'child_of', commercial_partner_id)]"
                            options="{'no_create': True}"
                        />
                        <field name="partner_id" />
                        <field name="commercial_partner_id" invisible="1" />
                    </group>
                    <group>
                        <field name="amount_total" />
                        <field
                            name="cfdi_amount_untaxed"
                            invisible="not l10n_mx_sat_document_id"
                        />
                        <field
                            name="mapped_amount_untaxed"
                            invisible="not l10n_mx_sat_document_id"
                        />
                        <field
                            name="allow_unmapped"
                            invisible="not l10n_mx_sat_document_id"
                        />
                        <field name="currency_id" invisible="1" />
                        <field name="company_id" invisible="1" />
                        <field
                            name="l10n_mx_sat_available_document_ids"
                            invisible="1"
                        />
                        <field name="l10n_mx_sat_document_id" invisible="1" />
                        <field name="concept_document_id" invisible="1" />
                        <field name="available_purchase_line_ids" invisible="1" />
                        <field name="total_mismatch" invisible="1" />
                    </group>
                </group>
                <notebook invisible="not line_ids">
                    <page string="SAT CFDIs" name="documents">
                        <field name="line_ids">
                            <list editable="bottom" create="0" delete="0">
                                <field name="selected" />
                                <field name="series" readonly="1" />
                                <field name="folio_number" readonly="1" />
                                <field name="issue_date" readonly="1" />
                                <field name="issuer_name" readonly="1" />
                                <field name="total" readonly="1" sum="Total" />
                                <field name="currency_code" readonly="1" />
                                <field name="sat_status" widget="badge" readonly="1" />
                                <field name="uuid" readonly="1" optional="hide" />
                                <field name="document_id" column_invisible="1" />
                            </list>
                        </field>
                    </page>
                    <page
                        string="Concepts"
                        name="concepts"
                        invisible="not l10n_mx_sat_document_id"
                    >
                        <field name="concept_ids">
                            <list editable="bottom" create="0" delete="0">
                                <field name="sequence" column_invisible="1" />
                                <field name="no_identificacion" />
                                <field name="description" />
                                <field name="product_service_code" optional="hide" />
                                <field name="quantity" />
                                <field name="unit_code" />
                                <field name="price_unit" />
                                <field name="discount_amount" optional="hide" />
                                <field name="amount" sum="Subtotal" />
                                <field name="tax_summary" optional="show" />
                                <field name="tax_amount" optional="hide" />
                                <field
                                    name="purchase_line_id"
                                    domain="[('id', 'in', parent.available_purchase_line_ids)]"
                                    options="{'no_create': True, 'no_open': True}"
                                />
                                <field name="purchase_qty_pending" />
                                <field name="purchase_uom_id" />
                                <field name="qty_to_invoice" />
                                <field
                                    name="product_id"
                                    column_invisible="not parent.allow_unmapped"
                                    readonly="purchase_line_id"
                                    options="{'no_create': True, 'no_open': True}"
                                />
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button
                        name="action_create_invoice"
                        string="Create Bill"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                        invisible="not line_ids"
                    />
                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                        data-hotkey="x"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
