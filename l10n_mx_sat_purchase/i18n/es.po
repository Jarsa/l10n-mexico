"The quantity to bill of '%(line)s' (%(quantity)s %(uom)s) exceeds its "
"pending quantity (%(pending)s %(uom)s)."
msgstr ""
"La cantidad a facturar de '%(line)s' (%(quantity)s %(uom)s) excede su "
"cantidad pendiente (%(pending)s %(uom)s)."

#. module: l10n_mx_sat_purchase
#. odoo-python
#: code:addons/l10n_mx_sat_purchase/wizards/l10n_mx_sat_purchase_invoice_wizard.py:0
msgid "The quantity to bill of the concept '%s' must be positive."
msgstr "La cantidad a facturar del concepto '%s' debe ser positiva."

#. module: l10n_mx_sat_purchase
#. odoo-python
#: code:addons/l10n_mx_sat_purchase/wizards/l10n_mx_sat_purchase_invoice_wizard.py:0
msgid ""
"The total of the bill (%(bill)s) differs from the total of the CFDI %(uuid)s"
" (%(cfdi)s). Review the quantities and taxes before posting it."
msgstr ""
"El total de la factura (%(bill)s) difiere del total del CFDI %(uuid)s "
"(%(cfdi)s). Revise las cantidades y los impuestos antes de confirmarla."

