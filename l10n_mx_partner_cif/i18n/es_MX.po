msgid ""
"<span invisible=\"cif_file == False\" colspan=\"2\">The CIF file uses OCR "
"technology to automate the input.<br/>You need to validate if the "
"information corresponds to CIF.<br/>It may happen that a field is not "
"filled, in that case you need to define it manually.</span>"
msgstr ""
"<span invisible=\"cif_file == False\" colspan=\"2\">El archivo CIF "
"utiliza tecnología OCR para automatizar la entrada.<br/> Es necesario "
"validar si la información corresponde al CIF.<br/> Puede suceder que "
"algún campo no esté rellenado, en ese caso es necesario definirlo "
"manualmente.</span>"

